<?xml version="1.0" encoding="utf-8"?>
<Report Version="2026.1" Name="Invoice" Description="Customer invoice template" Author="System" ScriptLanguage="CSharp" ConvertNulls="true" DoublePass="false">
  <Dictionary>
    <TableDataSource Name="InvoiceItems" DataType="SQLite" SelectCommand="SELECT * FROM InvoiceItems WHERE InvoiceId = @InvoiceId" CommandTimeout="30">
      <Column Name="Id" DataType="System.Int32"/>
      <Column Name="InvoiceId" DataType="System.Int32"/>
      <Column Name="Description" DataType="System.String"/>
      <Column Name="Quantity" DataType="System.Int32"/>
      <Column Name="UnitPrice" DataType="System.Decimal"/>
      <Column Name="LineTotal" DataType="System.Decimal"/>
      <Parameter Name="InvoiceId" DataType="System.Int32" Required="true" AllowNull="false" Hidden="false" MultiValue="false" Description="Invoice ID"/>
    </TableDataSource>
    <Parameter Name="InvoiceNumber" DataType="System.String" DefaultValue="INV-0001" Required="false" AllowNull="true" Hidden="false" MultiValue="false" Description="Invoice number"/>
    <Parameter Name="CustomerName" DataType="System.String" DefaultValue="Customer" Required="false" AllowNull="true" Hidden="false" MultiValue="false" Description="Customer name"/>
    <Parameter Name="InvoiceDate" DataType="System.DateTime" DefaultValue="2026-01-01" Required="false" AllowNull="true" Hidden="false" MultiValue="false" Description="Invoice date"/>
    <Parameter Name="DueDate" DataType="System.DateTime" DefaultValue="2026-02-01" Required="false" AllowNull="true" Hidden="false" MultiValue="false" Description="Payment due date"/>
  </Dictionary>
