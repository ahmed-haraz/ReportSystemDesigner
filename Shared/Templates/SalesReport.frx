<?xml version="1.0" encoding="utf-8"?>
<Report Version="2026.1" Name="Sales Report" Description="Monthly sales report template" Author="System" ScriptLanguage="CSharp" ConvertNulls="true" DoublePass="false">
  <Dictionary>
    <TableDataSource Name="SalesData" DataType="SQLite" SelectCommand="SELECT * FROM Sales WHERE Date BETWEEN @StartDate AND @EndDate" CommandTimeout="30">
      <Column Name="Id" DataType="System.Int32" Nullable="true" PrimaryKey="false" ReadOnly="false"/>
      <Column Name="ProductName" DataType="System.String" Caption="Product Name" Nullable="true" PrimaryKey="false" ReadOnly="false"/>
      <Column Name="Quantity" DataType="System.Int32" Nullable="true" PrimaryKey="false" ReadOnly="false"/>
      <Column Name="UnitPrice" DataType="System.Decimal" Nullable="true" PrimaryKey="false" ReadOnly="false" Format="C2"/>
      <Column Name="Total" DataType="System.Decimal" Nullable="true" PrimaryKey="false" ReadOnly="false" Format="C2"/>
      <Column Name="SaleDate" DataType="System.DateTime" Nullable="true" PrimaryKey="false" ReadOnly="false" Format="yyyy-MM-dd"/>
      <Column Name="Salesperson" DataType="System.String" Nullable="true" PrimaryKey="false" ReadOnly="false"/>
      <Parameter Name="StartDate" DataType="System.DateTime" Required="true" AllowNull="false" Hidden="false" MultiValue="false" Description="Start date for report period"/>
      <Parameter Name="EndDate" DataType="System.DateTime" Required="true" AllowNull="false" Hidden="false" MultiValue="false" Description="End date for report period"/>
    </TableDataSource>
    <Parameter Name="ReportTitle" DataType="System.String" DefaultValue="Monthly Sales Report" Required="false" AllowNull="true" Hidden="false" MultiValue="false" Description="Report title displayed at top"/>
    <Parameter Name="CompanyName" DataType="System.String" DefaultValue="My Company" Required="false" AllowNull="true" Hidden="false" MultiValue="false" Description="Company name for header"/>
  </Dictionary>
  <Styles/>
  <ReportPage Width="595" Height="842" LeftMargin="40" RightMargin="40" TopMargin="40" BottomMargin="40" Orientation="Portrait" PaperName="A4" ColumnWidth="0" ColumnCount="1" ColumnGap="0" Resolution="96">
