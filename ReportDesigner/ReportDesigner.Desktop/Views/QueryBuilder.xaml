<Window x:Class="ReportDesigner.Desktop.Views.QueryBuilder"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Query Builder" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SQL Query Builder" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="lstTables" Margin="0,0,5,0"/>

            <TextBox Grid.Column="1" x:Name="txtQuery" 
                     Text="SELECT * FROM " 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Execute" Click="Execute_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="OK" Click="OkButton_Click" Padding="20,5" Margin="0,0,10,0"/>
            <Button Content="Cancel" Click="CancelButton_Click" Padding="20,5"/>
        </StackPanel>
    </Grid>
</Window>
