<UserControl x:Class="ReportDesigner.Desktop.Views.ToolboxPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="250">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bands" FontWeight="Bold" Margin="5" Background="#E0E0E0" Padding="5"/>
        <ListBox Grid.Row="1" x:Name="BandListBox" ItemsSource="{Binding BandTypes}" 
                 SelectedItem="{Binding SelectedBandType}"
                 PreviewMouseLeftButtonDown="BandListBox_PreviewMouseLeftButtonDown"
                 MouseMove="BandListBox_MouseMove">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="LightBlue" Padding="5" Margin="2" CornerRadius="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="Objects" FontWeight="Bold" Margin="5" Background="#E0E0E0" Padding="5"/>
        <ListBox Grid.Row="3" x:Name="ObjectListBox" ItemsSource="{Binding ObjectTypes}" 
                 SelectedItem="{Binding SelectedObjectType}"
                 PreviewMouseLeftButtonDown="ObjectListBox_PreviewMouseLeftButtonDown"
                 MouseMove="ObjectListBox_MouseMove">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="LightGreen" Padding="5" Margin="2" CornerRadius="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
