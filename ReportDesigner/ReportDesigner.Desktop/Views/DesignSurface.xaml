<UserControl x:Class="ReportDesigner.Desktop.Views.DesignSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="842" d:DesignWidth="595">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Canvas Grid.Row="0" Background="#F0F0F0" x:Name="HorizontalRuler"/>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="PageContainer" Margin="50">
                <Border Background="#CCCCCC" Margin="5,5,0,0" 
                        Width="{Binding PageWidth}" 
                        Height="{Binding PageHeight}"/>

                <Border Background="White" BorderBrush="#999999" 
                        BorderThickness="1" 
                        Width="{Binding PageWidth}" 
                        Height="{Binding PageHeight}"
                        x:Name="PageBorder">
                    <Canvas x:Name="DesignCanvas" 
                            AllowDrop="True"
                            DragOver="DesignCanvas_DragOver"
                            Drop="DesignCanvas_Drop"
                            MouseLeftButtonDown="DesignCanvas_MouseLeftButtonDown"
                            MouseMove="DesignCanvas_MouseMove"
                            MouseLeftButtonUp="DesignCanvas_MouseLeftButtonUp">

                        <ItemsControl ItemsSource="{Binding Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="LightBlue" 
                                            Opacity="0.3"
                                            Height="{Binding Height}"
                                            Canvas.Top="{Binding Top}"
                                            Width="{Binding DataContext.PageWidth, 
                                                    RelativeSource={RelativeSource AncestorType=Canvas}}">
                                        <TextBlock Text="{Binding Name}" 
                                                   VerticalAlignment="Top" 
                                                   HorizontalAlignment="Left"
                                                   Margin="5,2" 
                                                   FontSize="10" 
                                                   Foreground="DarkBlue"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding SelectedBand.Objects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Canvas.Left="{Binding Left}" 
                                            Canvas.Top="{Binding Top}"
                                            Width="{Binding Width}" 
                                            Height="{Binding Height}"
                                            BorderBrush="Blue"
                                            BorderThickness="1"
                                            MouseLeftButtonDown="Object_MouseLeftButtonDown">
                                        <ContentControl Content="{Binding}">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" 
                                                               FontFamily="{Binding TextProps.FontName}"
                                                               FontSize="{Binding TextProps.FontSize}"
                                                               Foreground="Black"
                                                               TextAlignment="Left"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
