<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiReportEngine.MAUI.MainPage"
             Title="Report Engine">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Report Engine Demo" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Button Text="Generate Sales Report" 
                    Clicked="OnGenerateReportClicked"
                    BackgroundColor="#512BD4"
                    TextColor="White"/>

            <Button Text="View Templates" 
                    Clicked="OnViewTemplatesClicked"
                    BackgroundColor="#2B0B98"/>

            <Button Text="Settings" 
                    Clicked="OnSettingsClicked"/>

            <Label x:Name="StatusLabel" 
                   Text="Ready"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
